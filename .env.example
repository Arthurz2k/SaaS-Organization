# ============================================
# Copie para .env.local e preencha.
# .env.local NUNCA vai para o repositorio.
# ============================================

# --- Supabase ---
# Painel do projeto > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de servico: so no servidor, nunca com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# Painel do projeto > Settings > Database
DATABASE_URL=

# --- Aplicacao ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=pt-BR

# --- Sentry (semana 1 ou 2) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Resend (semana 11) ---
RESEND_API_KEY=
EMAIL_FROM=
